# ---- Server ----
NODE_ENV=production
PORT=8080
CLIENT_URL=http://localhost:3000

# ---- Database (used by knexfile.js at runtime) ----
DB_CLIENT=mysql2
DB_HOST=db
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change_me_in_real_env
DB_NAME=app_db

# Used by docker-compose to bootstrap MySQL:
MYSQL_ROOT_PASSWORD=change_me_in_real_env

# ---- Comment-notification webhook ----
# Random string used to verify X-Hub-Signature-256 on incoming GitHub webhooks
GITHUB_WEBHOOK_SECRET=replace_with_random_string
# Where to forward parsed notification events (Slack/Discord/Feishu/your own endpoint).
# Leave empty to disable outbound delivery.
NOTIFY_WEBHOOK_URL=
